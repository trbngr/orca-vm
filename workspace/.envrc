# Workspace-level direnv configuration — the root of your workspace on the box (~/<dir>).
# Seeded from orca-vm/workspace/.envrc by the image; edit in place, it is never overwritten.
#
# A repo's .envrc that ends with `source_up_if_exists` loads this file, so anything exported here is
# visible in every repo shell and every Orca worktree. Put workspace-wide variables here: a local
# package feed, a shared cache location, telemetry opt-outs, …

# Workspace root (the directory containing this .envrc).
export WORKSPACE_ROOT="$PWD"

# Workspace-level scripts on PATH (~/<dir>/scripts, if you create it).
PATH_add scripts
