# Azure resources for the host. Sourced by every script in this directory.
#
# The VM's name and the image architecture come from ../host.nix (hostName, system), so the VM Azure
# builds and the system Nix builds cannot disagree. VM_SIZE must match: an x64 size for x86_64-linux
# (Standard_D16ads_v5 — 16 vCPU AMD, 64 GiB, 600 GiB temp disk) or an ARM size for aarch64-linux
# (Standard_D16pds_v5, ~20 % cheaper). create-vm.sh refuses a size the subscription cannot have in the
# region before spending anything; `az vm list-skus -l <region> --size <family>` shows what you can.
HERE_="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
hostval() { nix eval --raw --file "$HERE_/../host.nix" "$1"; }
VM_NAME="${VM_NAME:-$(hostval hostName)}"
case "$(hostval system)" in
  x86_64-linux)  IMAGE_ARCH="${IMAGE_ARCH:-x64}" ;;
  aarch64-linux) IMAGE_ARCH="${IMAGE_ARCH:-arm64}" ;;
  *) echo "host.nix: unsupported system" >&2; return 2 2>/dev/null || exit 2 ;;
esac

AZ_SUBSCRIPTION="${AZ_SUBSCRIPTION:-00000000-0000-0000-0000-000000000000}"   # `az account list -o table`
AZ_LOCATION="${AZ_LOCATION:-eastus2}"
# Availability zones: some regions have none (northcentralus, for one) — there, leave AZ_ZONE empty
# and use Premium SSD v1 (Premium_LRS, sized tiers: a P30 / 1 TiB is the smallest with 5000 IOPS, and
# builds are IOPS-bound, so size buys speed). In a zonal region set AZ_ZONE and DATA_DISK_SKU=PremiumV2_LRS
# to dial IOPS and throughput independently of size.
AZ_ZONE="${AZ_ZONE:-}"                               # empty = non-zonal; "1".."3" = zonal (VM, PIP and data disk share it)
DATA_DISK_SKU="${DATA_DISK_SKU:-Premium_LRS}"        # Premium_LRS (v1, sized tiers) or PremiumV2_LRS (zonal only, IOPS dialled)
AZ_RG="${AZ_RG:-$VM_NAME-rg}"
VM_SIZE="${VM_SIZE:-Standard_D16ads_v5}"
IMAGE_URN_ARM64="Canonical:ubuntu-24_04-lts:server-arm64:latest"
IMAGE_URN_X64="Canonical:ubuntu-24_04-lts:server:latest"
# Outbound internet. A VM with no public IP has NO default outbound access on a VNet created after
# September 2025 (Azure retired it) — measured: the moment the install-window public IP was detached,
# nix, gh and Tailscale's control plane all went dark. A NAT gateway is the explicit outbound path:
# no inbound exposure, one stable egress IP, ~$32/mo plus data.
NAT_GATEWAY="${NAT_GATEWAY:-true}"
OS_DISK_GB="${OS_DISK_GB:-128}"
DATA_DISK_GB="${DATA_DISK_GB:-1024}"                 # /home: checkouts, worktrees, caches, Orca state
DATA_DISK_IOPS="${DATA_DISK_IOPS:-6000}"             # PremiumV2_LRS only: IOPS and MB/s are dialled independently of size
DATA_DISK_MBPS="${DATA_DISK_MBPS:-300}"
ADMIN_USER="${ADMIN_USER:-azureuser}"                # the stock image's user; nixos-anywhere sudo's through it, then it is gone
SSH_PUBKEY="${SSH_PUBKEY:-$HOME/.ssh/id_ed25519.pub}" # the key you SSH from; also list it in host.nix
